[user]
    name = Mark
    email = 149008372+markduplock@users.noreply.github.com

[core]
    editor = code
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    default = simple

[alias]
    st = status
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate --all
